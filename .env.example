# Cloud chat settings
CHAT_PROVIDER=ollama_cloud
LLAMA_API_KEY=replace_with_your_ollama_dashboard_key
LLAMA_CLOUD_MODEL=gemma4:31b
LLAMA_CLOUD_URL=https://ollama.com

# Local embedding settings (still required for FAISS indexing)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# Local chat settings
# Uncomment the following lines to use a local model instead of the cloud model.
# CHAT_PROVIDER=ollama_local
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CHAT_MODEL=llama3.2:latest

PDF_FILENAME=example_eticket.pdf
# Optional override with an absolute path:
# PDF_PATH=/absolute/path/to/your.pdf

# Optional remote PDF source URL. Leave empty for local-only mode.
# SOURCE_URL=https://example.com/your.pdf
